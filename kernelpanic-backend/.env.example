DATABASE_URL="postgresql://kernelpanic:kernelpanic@localhost:5432/kernelpanic?schema=public"
# tamanho do pool de conexões do driver "pg" (padrão dele é 10 — baixo para
# o volume de ingestão em lote, ver teste de carga)
DATABASE_POOL_MAX=30
# banco dos testes funcionais, apagado a cada execução (o nome precisa terminar em "_test").
# se omitido, usa o de DATABASE_URL com o sufixo "_test"
# DATABASE_URL_TESTE="postgresql://kernelpanic:kernelpanic@localhost:5432/kernelpanic_test?schema=public"

PORT=3001

JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="1h"

# false em dev (http), true em producao atras de https
COOKIE_SECURE=false
# "lax" enquanto front e back estao no mesmo dominio (ex.: localhost em portas diferentes)
# "none" quando forem dominios diferentes em producao (exige COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

FRONTEND_URL="http://localhost:3000"

# credenciais do usuário criado por "npm run db:seed" (bootstrap, ver README)
SEED_USUARIO_NOME="Administrador"
SEED_USUARIO_EMAIL="admin@kernelpanic.dev"
SEED_USUARIO_SENHA="admin12345"

# limite de requisições por IP por minuto (toda a API, exceto a ingestão)
LIMITE_REQUISICOES_POR_MINUTO=120
# limite de tentativas de login por IP por minuto (contra força bruta)
LIMITE_LOGIN_POR_MINUTO=5

# envia os alarmes novos por websocket (namespace /alarmes) assim que o
# trigger do banco os dispara; "false" desliga a conexão LISTEN com o Postgres
ALARMES_TEMPO_REAL=true

# ---------------- Broker MQTT (docker-compose.yml, serviço "broker") ----------------
# Sem MQTT_URL o backend não cadastra as estações no broker e a ingestão só
# recebe pela rota HTTP.
MQTT_URL="mqtt://localhost:1883"
# admin do plugin dynamic-security: o backend cadastra cada estação (usuário =
# vid, senha = chave de ingestão) com ele
MQTT_ADMIN_USUARIO="admin"
MQTT_ADMIN_SENHA="admin-dev"

# ---------------- Serviço de ingestão (servicos/ingestao, VPS 2) ----------------
INGESTAO_PORTA=3002
# usuário com que a ingestão assina estacoes/+/telemetria (criado pelo broker/iniciar.sh)
MQTT_INGESTAO_USUARIO="ingestao"
MQTT_INGESTAO_SENHA="ingestao-dev"
# clientId fixo: com a sessão persistente, o broker guarda as mensagens
# enquanto a ingestão está fora do ar e entrega quando ela volta
MQTT_INGESTAO_CLIENT_ID="ingestao"

# a rota HTTP da ingestão exige no header "x-chave-estacao" a chave da própria
# estação (gerada no cadastro ou em POST /estacoes/:id/chave-ingestao).
# "true" abre a rota sem chave, aceito só com NODE_ENV=development ou test:
# em qualquer outro ambiente o serviço não sobe.
# NODE_ENV=development
INGESTAO_ROTA_ABERTA=false

# a ingestão acumula as leituras brutas em memória e grava em lote. Flush ao
# atingir o tamanho máximo OU ao vencer o intervalo, o que vier primeiro. O
# intervalo é curto porque a leitura precisa virar medida em até 2 s.
INGESTAO_LOTE_TAMANHO_MAX=5000
INGESTAO_LOTE_INTERVALO_MS=250
# tentativas de gravar um lote antes de descartá-lo (com log de erro trazendo
# os itens); a cada falha o lote volta para o próximo flush
INGESTAO_LOTE_TENTATIVAS_MAX=5
# prazo para gravar o buffer ao encerrar (SIGTERM); abaixo dos 10 s do
# docker stop, para o descarte sair no log antes do SIGKILL
INGESTAO_ENCERRAMENTO_PRAZO_MS=8000

# ---------------- Serviço de tratamento (servicos/tratamento, VPS 4) ----------------
TRATAMENTO_PORTA=3003
# leituras brutas por transação (cada uma gera até 50 medidas)
TRATAMENTO_LOTE_TAMANHO=1000
# varredura de segurança; o gatilho normal é o aviso do banco (LISTEN)
TRATAMENTO_INTERVALO_MS=1000
