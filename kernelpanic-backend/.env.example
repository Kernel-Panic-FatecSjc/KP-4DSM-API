DATABASE_URL="postgresql://kernelpanic:kernelpanic@localhost:5432/kernelpanic?schema=public"
# tamanho do pool de conexões do driver "pg" (padrão dele é 10 — baixo para
# o volume de ingestão em lote, ver teste de carga)
DATABASE_POOL_MAX=30
# banco dos testes funcionais, apagado a cada execução (o nome precisa terminar em "_test").
# se omitido, usa o de DATABASE_URL com o sufixo "_test"
# DATABASE_URL_TESTE="postgresql://kernelpanic:kernelpanic@localhost:5432/kernelpanic_test?schema=public"

PORT=3001

JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="1h"

# false em dev (http), true em producao atras de https
COOKIE_SECURE=false
# "lax" enquanto front e back estao no mesmo dominio (ex.: localhost em portas diferentes)
# "none" quando forem dominios diferentes em producao (exige COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

FRONTEND_URL="http://localhost:3000"

# credenciais do usuário criado por "npm run db:seed" (bootstrap, ver README)
SEED_USUARIO_NOME="Administrador"
SEED_USUARIO_EMAIL="admin@kernelpanic.dev"
SEED_USUARIO_SENHA="admin12345"

# chave compartilhada exigida no header "x-chave-estacao" da rota de ingestão
# (se vazia, a rota fica aberta — use apenas em desenvolvimento)
INGESTAO_CHAVE_API=""

# a ingestão acumula medidas em memória e grava em lote (um INSERT só, para
# o trigger de alertas rodar por statement em vez de por linha). Flush ao
# atingir o tamanho máximo OU ao vencer o intervalo, o que vier primeiro.
INGESTAO_LOTE_TAMANHO_MAX=5000
INGESTAO_LOTE_INTERVALO_MS=2000
