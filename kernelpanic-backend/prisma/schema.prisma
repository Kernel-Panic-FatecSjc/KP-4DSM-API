// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum TipoUsuario {
  ADMINISTRADOR
  MONITOR
}

enum OperadorAlerta {
  MAIOR_QUE
  MENOR_QUE
  IGUAL_A
  DIFERENTE_DE
  MAIOR_OU_IGUAL
  MENOR_OU_IGUAL
}

enum SeveridadeAlerta {
  ATENCAO
  ALERTA
  EMERGENCIA
}

enum StatusAlarme {
  ABERTO
  RECONHECIDO
  RESOLVIDO
}

enum StatusOperacionalEstacao {
  ATIVA
  INATIVA
}

enum EsferaOrgao {
  MUNICIPAL
  ESTADUAL
  FEDERAL
}

enum ModalidadeLicitacao {
  PREGAO
  CONCORRENCIA
  CONCURSO
  LEILAO
  DIALOGO_COMPETITIVO
  DISPENSA
  INEXIGIBILIDADE
  OUTRA
}

enum StatusContrato {
  RASCUNHO
  VIGENTE
  SUSPENSO
  ENCERRADO
}

model Usuario {
  id           String      @id @default(uuid())
  nome         String
  tipo         TipoUsuario @default(ADMINISTRADOR)
  email        String      @unique
  senhaHash    String
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  estacoes      Estacao[]
  logsAuditoria LogAuditoria[]

  @@map("usuarios")
}

/// Órgão público contratante.
model OrgaoPublico {
  id           String      @id @default(uuid())
  nome         String
  cnpj         String?     @unique
  esfera       EsferaOrgao
  municipio    String
  uf           String      @db.Char(2)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  contratos Contrato[]

  @@map("orgaos_publicos")
}

/// Processo licitatório. Uma licitação pode estar relacionada a vários contratos.
/// O contrato pode existir sem licitação vinculada, quando aplicável.
model Licitacao {
  id             String              @id @default(uuid())
  numeroProcesso String              @unique
  modalidade     ModalidadeLicitacao
  objeto         String?
  criadoEm       DateTime            @default(now())
  atualizadoEm   DateTime            @updatedAt

  contratos Contrato[]

  @@index([modalidade])
  @@map("licitacoes")
}

/// Contratos relacionados a um órgão público e, opcionalmente, a uma licitação.
model Contrato {
  id             String         @id @default(uuid())
  numero         String         @unique
  objeto         String
  inicioVigencia DateTime
  fimVigencia    DateTime
  status         StatusContrato @default(RASCUNHO)
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
  encerradoEm    DateTime?

  orgaoId String
  orgao   OrgaoPublico @relation(fields: [orgaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  estacoes Estacao[]

  @@index([orgaoId])
  @@index([status])
  @@index([licitacaoId])
  @@map("contratos")
}

/// Estações físicas de coleta.
model Estacao {
  id                String                   @id @default(uuid())
  nome              String
  endereco          String
  vid               String                   @unique
  latitude          Float                    @default(0)
  longitude         Float                    @default(0)
  statusOperacional StatusOperacionalEstacao @default(ATIVA)
  /// SHA-256 da chave que a estação manda no header da ingestão. A chave em si
  /// só aparece uma vez, ao cadastrar ou regenerar; nula = estação sem chave.
  chaveIngestaoHash String?
  criadoEm          DateTime                 @default(now())
  atualizadoEm      DateTime                 @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  parametros Parametro[]
  medidas    Medida[]

  @@index([contratoId])
  @@map("estacoes")
}

/// Definição global dos tipos de sensores/métricas (ex.: pluviômetro, temperatura).
model TipoParametro {
  id          String @id @default(uuid())
  nome        String
  unidade     String
  fator       Float
  ganho       Float
  json        Json?
  /// Faixa física válida da leitura (inclusiva e opcional): fora dela a
  /// ingestão não grava medida e registra a leitura em leituras_erro.
  valorMinimo Float?
  valorMaximo Float?

  parametros Parametro[]

  @@map("tipos_parametro")
}

/// Associa uma estação aos tipos de parâmetros que ela suporta.
model Parametro {
  id       String   @id @default(uuid())
  criadoEm DateTime @default(now())

  estacaoId String
  estacao   Estacao @relation(fields: [estacaoId], references: [id], onDelete: Cascade)

  tipoParametroId String
  tipoParametro   TipoParametro @relation(fields: [tipoParametroId], references: [id])

  medidas Medida[]
  alertas Alerta[]

  @@unique([estacaoId, tipoParametroId])
  @@map("parametros")
}

/// Leituras coletadas ao longo do tempo (série temporal). Imutável: trigger no banco
/// barra update/delete, inclusive o cascade vindo de Estacao e Parametro.
model Medida {
  id       String @id @default(uuid())
  unixtime BigInt
  valor    Float

  parametroId String
  parametro   Parametro @relation(fields: [parametroId], references: [id], onDelete: Cascade)

  estacaoId String
  estacao   Estacao @relation(fields: [estacaoId], references: [id], onDelete: Cascade)

  alarmes Alarme[]

  @@unique([parametroId, unixtime])
  @@index([estacaoId, unixtime])
  // Consulta por janela de tempo sem filtrar a estação (dashboard geral): sem
  // este índice ela lê a tabela inteira e ordena (1,3 s com 10 milhões de linhas).
  @@index([unixtime])
  @@map("medidas")
}

/// Regras de limite e condições lógicas vinculadas a um parâmetro.
model Alerta {
  id          String           @id @default(uuid())
  operador    OperadorAlerta
  valorLimite Float
  severidade  SeveridadeAlerta
  ativo       Boolean          @default(true)
  criadoEm    DateTime         @default(now())

  parametroId String
  parametro   Parametro @relation(fields: [parametroId], references: [id], onDelete: Cascade)

  alarmes Alarme[]

  @@map("alertas")
}

/// Histórico de ocorrências que relaciona uma medida ao alerta correspondente.
model Alarme {
  id          String       @id @default(uuid())
  disparadoEm DateTime     @default(now())
  status      StatusAlarme @default(ABERTO)

  alertaId String
  alerta   Alerta @relation(fields: [alertaId], references: [id], onDelete: Cascade)

  medidaId String
  medida   Medida @relation(fields: [medidaId], references: [id], onDelete: Cascade)

  @@map("alarmes")
}

/// Payload bruto recebido diretamente do datalogger (ESP32), como chegou, antes de
/// qualquer validação/normalização em Parametro/Medida. Imutável (trigger no banco
/// barra update/delete) — preserva a procedência técnica do dado e o momento exato
/// de recebimento (RF03/US04).
model LeituraBruta {
  id                  String                               @id @default(uuid())
  vidEstacao          String
  payload             Json
  localizacao         Unsupported("geometry(Point, 4326)")
  unixtimeDispositivo BigInt
  recebidoEm          DateTime                             @default(now())

  @@index([vidEstacao, recebidoEm])
  @@map("leituras_brutas")
}

/// Por que uma leitura recebida não virou medida: o pacote original continua
/// intacto em leituras_brutas, e cada leitura rejeitada fica registrada aqui.
enum MotivoLeituraErro {
  SENSOR_NAO_CONFIGURADO
  ABAIXO_DO_MINIMO
  ACIMA_DO_MAXIMO
  ESTACAO_NAO_CADASTRADA
}

/// Leitura que a ingestão recebeu mas não gravou como medida. Sem chaves
/// estrangeiras, como leituras_brutas: é gravada junto com ela, em paralelo, e
/// precisa sobreviver a uma estação ou sensor removido.
model LeituraErro {
  id             String            @id @default(uuid())
  leituraBrutaId String
  vidEstacao     String
  nomeSensor     String
  /// Nulo quando o sensor não tem parâmetro configurado na estação.
  parametroId    String?
  valor          Float
  unixtime       BigInt
  motivo         MotivoLeituraErro
  /// Faixa vigente quando a leitura chegou, para o registro não depender do cadastro atual.
  valorMinimo    Float?
  valorMaximo    Float?
  registradoEm   DateTime          @default(now())

  @@index([leituraBrutaId])
  @@index([vidEstacao, registradoEm])
  @@map("leituras_erro")
}

/// Trilha de auditoria: registro imutável (sem updatedAt e protegida por trigger
/// contra update/delete) de ações executadas por usuários no sistema, para rastreabilidade
/// forense e prestação de contas (RF: auditoria/LGPD, US07).
/// `acao` segue a convenção "recurso.verbo" (ex.: "usuarios.criar",
/// "autenticacao.login", "alertas.inativar") em vez de enum, para não exigir
/// migration a cada nova ação auditável.
model LogAuditoria {
  id         String   @id @default(uuid())
  acao       String
  entidade   String
  entidadeId String?
  detalhes   Json?
  enderecoIp String?
  criadoEm   DateTime @default(now())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@map("logs_auditoria")
}
