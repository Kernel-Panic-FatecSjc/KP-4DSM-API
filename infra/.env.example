# Modelo do .env de cada ambiente no servidor, em
# /opt/kp4dsm/<ambiente>/.env (docs/CD.md, "Preparar o servidor").
# Este arquivo é versionado; o .env real NUNCA é: ele só existe no servidor.

# homologacao | producao. O seed sintético se recusa a rodar fora de homologação.
AMBIENTE=homologacao
# Distingue os containers dos dois ambientes quando estão na mesma VPS.
COMPOSE_PROJECT_NAME=kp4dsm-homologacao

# Portas publicadas pelo Caddy. Na mesma VPS, cada ambiente usa as suas.
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
# URL que os smoke tests usam no próprio servidor. Com SITE_ADDRESS=:80 o
# padrão http://localhost:$HTTP_PORT basta; com domínio, use https://<domínio>.
# URL_SMOKE=

# Escrita pelo deploy; não edite.
IMAGE_TAG=

POSTGRES_USER=kernelpanic
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=kernelpanic
DATABASE_URL=postgresql://kernelpanic:troque-por-uma-senha-forte@postgres:5432/kernelpanic?schema=public

JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=1h
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:8080

SEED_USUARIO_NOME=Administrador
SEED_USUARIO_EMAIL=admin@kernelpanic.dev
SEED_USUARIO_SENHA=troque-esta-senha

# Chave exigida no header x-chave-estacao. Use valores DIFERENTES em cada
# ambiente: o smoke test de homologação lê a chave daqui, e ela nunca pode
# servir para gravar telemetria em produção.
INGESTAO_CHAVE_API=troque-por-uma-chave-exclusiva-do-ambiente
