# .env de um ambiente no servidor (pré-release ou produção).
# preparar-servidor.sh copia este arquivo para $BASE/shared/.env na primeira
# execução. Preencha TODOS os campos marcados com TROQUE antes de rodar o
# script de novo. O arquivo fica só no servidor: nunca no Git, nunca no pacote.
# Explicação de cada variável: kernelpanic-backend/.env.example.

# ---------------- Endereço público e portas ----------------
# Domínio do ambiente (o Caddy emite o certificado HTTPS para ele).
# Ex.: alertas.exemplo.gov.br na produção, pre-alertas.exemplo.gov.br na pré-release.
DOMINIO="TROQUE.exemplo.gov.br"
# Portas locais (só 127.0.0.1; o mundo entra pelo Caddy em 443). Dois
# ambientes no mesmo servidor precisam de portas diferentes.
PORT=3001
INGESTAO_PORTA=3002
TRATAMENTO_PORTA=3003
FRONT_PORTA=3000

# ---------------- Banco ----------------
# Pré-release e produção usam bancos DIFERENTES.
DATABASE_URL="postgresql://datapanic:TROQUE@localhost:5432/datapanic?schema=public"
DATABASE_POOL_MAX=30

# ---------------- Sessão e segurança ----------------
NODE_ENV=production
# Gere com: openssl rand -base64 48
JWT_SECRET="TROQUE"
JWT_EXPIRES_IN="1h"
# HTTPS pelo Caddy: cookie seguro. Front e API na mesma origem: lax basta.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Mesma origem do site (https:// + DOMINIO).
FRONTEND_URL="https://TROQUE.exemplo.gov.br"
# Um salto: o Caddy na mesma máquina.
TRUST_PROXY=loopback
LIMITE_REQUISICOES_POR_MINUTO=120
LIMITE_LOGIN_POR_MINUTO=5
ALARMES_TEMPO_REAL=true

# ---------------- Primeiro administrador (npm run db:seed, uma vez) ----------------
SEED_USUARIO_NOME="Administrador"
SEED_USUARIO_EMAIL="TROQUE@exemplo.gov.br"
SEED_USUARIO_SENHA="TROQUE"

# ---------------- Broker MQTT (Mosquitto com dynamic-security) ----------------
MQTT_URL="mqtt://localhost:1883"
MQTT_ADMIN_USUARIO="admin"
MQTT_ADMIN_SENHA="TROQUE"
MQTT_INGESTAO_USUARIO="ingestao"
MQTT_INGESTAO_SENHA="TROQUE"
# Dois ambientes no mesmo broker: clientId diferente em cada um.
MQTT_INGESTAO_CLIENT_ID="ingestao"

# ---------------- Ingestão e tratamento ----------------
INGESTAO_ROTA_ABERTA=false
INGESTAO_LOTE_TAMANHO_MAX=5000
INGESTAO_LOTE_INTERVALO_MS=250
INGESTAO_LOTE_TENTATIVAS_MAX=5
INGESTAO_ENCERRAMENTO_PRAZO_MS=8000
TRATAMENTO_LOTE_TAMANHO=1000
TRATAMENTO_INTERVALO_MS=1000
