# Gerado por infra/servidor/preparar-servidor.sh a partir de servico.modelo.
[Unit]
Description=DATA PANIC @NOME@ (@PREFIXO@)
After=network-online.target postgresql.service mosquitto.service
Wants=network-online.target

[Service]
User=@USUARIO@
Group=@USUARIO@
WorkingDirectory=@BASE@/current/@PASTA@
EnvironmentFile=@BASE@/shared/.env
ExecStart=@EXEC@
Restart=always
RestartSec=3
# A ingestão grava o lote em memória ao receber SIGTERM (prazo de 8 s).
TimeoutStopSec=15
# Muitos usuários simultâneos = muitos sockets abertos (websocket de alarmes).
LimitNOFILE=200000
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
