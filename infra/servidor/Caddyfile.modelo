# Gerado por infra/servidor/preparar-servidor.ps1 a partir de Caddyfile.modelo.
# Uma origem só por ambiente: o front em /, a API em /api (o front é construído
# com NEXT_PUBLIC_API_URL=/api). O Caddy emite e renova o certificado HTTPS
# sozinho se @DOMINIO@ resolver para este servidor e as portas 80/443 estiverem
# abertas; rede interna sem DNS público: troque por "tls internal" ou pelo
# certificado da prefeitura (tls <cert> <chave>).
@DOMINIO@ {
	encode zstd gzip

	# API, inclusive o websocket de alarmes (/api/socket.io/*). O prefixo sai
	# antes de chegar no Nest.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:@PORT@
	}

	# Rota HTTP da ingestão (estações sem MQTT). Exige x-chave-estacao.
	handle_path /ingestao/* {
		reverse_proxy 127.0.0.1:@INGESTAO_PORTA@
	}

	# Alerta público: HTML/CSS/JS estáticos e o alertas.json que o worker da API
	# regrava a cada alarme novo. Não passa pela API nem pelo banco; o Cache-Control
	# curto deixa um CDN na frente absorver os leitores.
	handle /alerta/dados/* {
		uri strip_prefix /alerta/dados
		root * @BASE@/shared/publico
		header Cache-Control "public, max-age=30"
		file_server
	}

	redir /alerta /alerta/ permanent

	handle_path /alerta/* {
		root * @BASE@/current/infra/servidor/alerta-publico
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:@FRONT_PORTA@
	}

	log {
		output file @LOG@ {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
